# Service
SERVICE_NAME=forms
APP_NAME=forms

# Database (preferred)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5437/itq_forms

# Database (fallback when DATABASE_URL is not set)
DATABASE_ENGINE=django_prometheus.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASS=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Auth / Keycloak
KEYCLOAK_REALM=
KEYCLOAK_BASE_URL=
# Derived automatically from SERVICE_NAME/APP_NAME: <name>-api

# gRPC
USERS_GRPC_TARGET=localhost:50051

# Messaging
NATS_URL=nats://localhost:4222
MESSAGE_BROKER_SUBJECTS=
JETSTREAM_ENABLED=true
JETSTREAM_STREAM_NAME=FORMS
JETSTREAM_STREAM_SUBJECTS=forms.>
OUTBOX_SUBJECT_PREFIX=forms

# Inbound catalog consumer subscriptions
RECOMMENDABLE_CONSUMER_SUBJECTS=courses.>,videos.>,articles.>

# Optional runtime
ALLOWED_HOSTS=
POD_IP=
