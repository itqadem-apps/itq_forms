# Service info
SERVICE_NAME=forms
APP_NAME=forms
DATABASE_URL=postgresql+asyncpg://itqadem:pass@localhost:5437/itq_forms
ACL_DATABASE_URL=postgresql+asyncpg://itqadem:secret@localhost:5438/itq_users
VERSION=1.0.0
DEBUG=False
# ACL DB (read-only, owned by itq_users SoT). Required for runtime auth
# context resolution and the 0035 backfill migration. Local dev: run
# itq_users' docker-compose so its Postgres is reachable on port 5438.

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_ALLOWED_CREDENTIALS=True

# Metrics
METRICS_ENABLED=True

# Auth
AUTH_ENABLED=True
JWKS_CACHE_TTL=500
KEYCLOAK_REALM=Itqadem
KEYCLOAK_BASE_URL=https://idp.fritill.ae
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASS=

# gRPC
USERS_GRPC_TARGET=localhost:50051

# NATS / messaging
NATS_URL=nats://localhost:4222
JETSTREAM_ENABLED=true

# Producer-owned stream settings
JETSTREAM_STREAM_NAME=FORMS
JETSTREAM_STREAM_SUBJECTS=forms.>
OUTBOX_SUBJECT_PREFIX=forms

# Canonical subscription contract key
MESSAGE_BROKER_SUBJECTS=courses.>,videos.>,articles.>,reservations.>

# Unified JetStream consumers (optional; format: label|subject|durable)
JETSTREAM_CONSUMERS=auth|auth.UserRegistered|forms-auth-user-registered-consumer
# Subjects consumed by consume_user_child_events for the local child projection
USERS_CHILD_EVENT_SUBJECTS=users.child.>,users.child_guardian.>
USERS_CHILD_EVENT_STREAM_NAME=USERS
USERS_CHILD_EVENT_STREAM_SUBJECTS=users.>
JETSTREAM_PULL_BATCH=10
JETSTREAM_PULL_TIMEOUT=1.0

# Database fallback (used only when DATABASE_URL is unset)
DATABASE_ENGINE=django_prometheus.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASS=
DATABASE_HOST=localhost
DATABASE_PORT=5432


# Optional runtime
ALLOWED_HOSTS=
POD_IP=
