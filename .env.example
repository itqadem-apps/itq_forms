# Service info
SERVICE_NAME=forms
APP_NAME=forms
DATABASE_URL=postgresql+asyncpg://itqadem:pass@localhost:5437/itq_forms
ACL_DATABASE_URL=postgresql+asyncpg://itqadem:secret@localhost:5438/itq_users
VERSION=1.0.0
DEBUG=False
# ACL DB (read-only, owned by itq_users SoT). Required for runtime auth
# context resolution and the 0035 backfill migration. Local dev: run
# itq_users' docker-compose so its Postgres is reachable on port 5438.

# CORS
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_ALLOWED_CREDENTIALS=True

# Metrics
METRICS_ENABLED=True

# Auth
AUTH_ENABLED=True
JWKS_CACHE_TTL=500
KEYCLOAK_REALM=Itqadem
KEYCLOAK_BASE_URL=https://idp.fritill.ae
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASS=
# JWT audience verified by pkg_auth's IdentityMiddleware. Tokens whose
# `aud` claim does NOT contain this exact string are rejected (silently
# in stock pkg_auth — LoggingIdentityMiddleware logs the reason). If the
# frontend Keycloak client doesn't have an audience mapper for `forms-api`,
# either add one in Keycloak or set this to whatever the tokens actually
# carry (e.g. `account`). Defaults to `${SERVICE_NAME}-api` when unset.
KEYCLOAK_AUDIENCE=forms-api

# gRPC
USERS_GRPC_TARGET=localhost:50051

# NATS / messaging
# Static stream names, subjects, and durable consumers live in app/messaging_contract.py.
NATS_URL=nats://localhost:4222
JETSTREAM_ENABLED=true

OUTBOX_SUBJECT_PREFIX=forms
JETSTREAM_PULL_BATCH=10
JETSTREAM_PULL_TIMEOUT=1.0

# Database fallback (used only when DATABASE_URL is unset)
DATABASE_ENGINE=django_prometheus.db.backends.sqlite3
DATABASE_NAME=db.sqlite3
DATABASE_USER=
DATABASE_PASS=
DATABASE_HOST=localhost
DATABASE_PORT=5432


# Optional runtime
ALLOWED_HOSTS=
POD_IP=
