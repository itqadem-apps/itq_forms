# =============================================================================
# itq_forms environment variables
# =============================================================================
# Every variable below is consumed by the code. Anything not in this file is
# either hardcoded or has a sensible runtime default.
#
# Sources:
#   - app/settings.py: most of the file
#   - pkg_auth.admin.env: KEYCLOAK_ADMIN_*, KEYCLOAK_FRONTEND_CLIENT_IDS,
#     VERIFY_SSL — only read by `python manage.py provision_keycloak`
# =============================================================================


# ---- Service identity --------------------------------------------------------
# Used to compute KEYCLOAK_CLIENT_ID = "${SERVICE_NAME}-api" and as the default
# OUTBOX_SUBJECT_PREFIX. APP_NAME is a fallback for SERVICE_NAME and is also
# read by pkg_auth.admin during provision_keycloak.
SERVICE_NAME=forms
APP_NAME=forms


# ---- Primary database --------------------------------------------------------
# When DATABASE_URL is set, the DATABASE_* fallback fields are ignored.
# Both `postgres://` and `postgresql+asyncpg://` URLs are accepted.
DATABASE_URL=postgresql+asyncpg://itq_user:secret@localhost:5434/itq_forms

# Used only when DATABASE_URL is unset.
DATABASE_ENGINE=django_prometheus.db.backends.postgresql
DATABASE_NAME=itq_forms
DATABASE_USER=itq_user
DATABASE_PASS=secret
DATABASE_HOST=localhost
DATABASE_PORT=5434


# ---- ACL database (Mode B: owned by itq_users) -------------------------------
# Required for runtime auth-context resolution and for the 0035 organization_id
# backfill migration. AclRouter pins all `pkg_auth_acl` queries here. If unset,
# the router falls through to `default` (dev-friendly; real deployments must
# point this at the itq_users-managed ACL Postgres).
ACL_DATABASE_URL=postgresql+asyncpg://itq_user:secret@localhost:5438/itq_users


# ---- Keycloak (runtime) ------------------------------------------------------
KEYCLOAK_BASE_URL=https://idp.fritill.ae
KEYCLOAK_REALM=Itqadem

# JWT audience verified by pkg_auth IdentityMiddleware. Tokens whose `aud`
# claim does NOT contain this exact string are rejected (now logged by
# app.auth.LoggingIdentityMiddleware). Defaults to `${SERVICE_NAME}-api` when
# unset. If the frontend Keycloak client lacks an audience mapper for
# `forms-api`, either add one in Keycloak or set this to whatever the tokens
# actually carry.
KEYCLOAK_AUDIENCE=forms-api

# Cached at startup by app.platform.init_platform_org_id_sync; the row with
# this slug must exist in the ACL `organizations` table.
PLATFORM_ORG_SLUG=platform

# CSV of ISO-4217 codes. After every Survey/SurveyCollection save, a Price row
# with amount_cents=0 is auto-created for any currency in this list that the
# parent doesn't already have. Empty disables the backfill.
AVAILABLE_CURRENCIES=EGP,USD,EUR,SAR


# ---- Keycloak admin (only used by `manage.py provision_keycloak`) ------------
# Leave empty in environments that don't run provisioning.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASS=
# CSV of frontend client IDs whose tokens should carry this service's audience.
KEYCLOAK_FRONTEND_CLIENT_IDS=frontend-admin,frontend-web
VERIFY_SSL=true


# ---- gRPC --------------------------------------------------------------------
USERS_GRPC_TARGET=localhost:50051


# ---- NATS / JetStream --------------------------------------------------------
# When NATS_URL is unset, NATS_HOST + NATS_PORT are combined into a URL.
NATS_URL=nats://localhost:4222
# NATS_HOST=localhost
# NATS_PORT=4222

JETSTREAM_ENABLED=true
JETSTREAM_PULL_BATCH=10
JETSTREAM_PULL_TIMEOUT=1.0


# ---- Outbox (unimessaging) ---------------------------------------------------
# Static stream names, subjects, and durable consumers live in
# app/messaging_contract.py — they are not env-configurable.
OUTBOX_SUBJECT_PREFIX=forms
OUTBOX_POLL_INTERVAL=0.5
OUTBOX_BATCH_SIZE=50


# ---- Media library -----------------------------------------------------------
# Read by itq_assessments.media_library.client.build_client(). Leave
# MEDIA_LIBRARY_URL or MEDIA_LIBRARY_TENANT_ID empty to disable the client —
# `python manage.py sync_media_policies` will then exit with an error.
# Token is optional (used as Bearer auth when set).
MEDIA_LIBRARY_URL=
MEDIA_LIBRARY_TENANT_ID=
MEDIA_LIBRARY_TOKEN=


# ---- Runtime -----------------------------------------------------------------
# Comma-separated. POD_IP, when set, is appended to ALLOWED_HOSTS.
ALLOWED_HOSTS=
POD_IP=
